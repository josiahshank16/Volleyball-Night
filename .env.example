# Copy to .env.local in Codespaces after registering a Firebase Web App.
# Firebase client configuration is designed to be public; NEVER add
# service account private keys, admin credentials, or GitHub tokens here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
