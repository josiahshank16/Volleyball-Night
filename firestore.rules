rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Initial organizer allowlist. This UID must match a successfully
    // authenticated Firebase Authentication user. It is not a password.
    function isOrganizer() {
      return request.auth != null
        && request.auth.uid == 'lzA887v8R7d4yWoxVlHMG9ISrAK2';
    }

    // A harmless test record to verify signed-in Firestore access.
    match /organizerChecks/{userId} {
      allow read, create, update: if isOrganizer()
        && userId == request.auth.uid;
      allow delete: if false;
    }

    // Explicit, organizer-only backups. Never publicly readable:
    // these contain names, profile attributes, teams, and history.
    match /organizerBackups/{backupId} {
      allow read, create, update: if isOrganizer()
        && backupId == 'latest';
      allow delete: if false;
    }

    // Transitional organizer-only live session. Never publicly readable.
    // The entire prototype state currently lives in one document, with no
    // kiosk/scorekeeper permissions until granular role rules are ready.
    match /liveSessions/{sessionId} {
      allow get: if isOrganizer() && sessionId == 'current';
      allow list, delete: if false;
      allow create, update: if isOrganizer()
        && sessionId == 'current'
        && request.resource.data.keys().hasOnly([
          'payload', 'schemaVersion', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.schemaVersion == 1
        && request.resource.data.payload is map;
    }

    // Only the minimal, organizer-published TV projection is public.
    // Personal ratings, gender, height, attendance, history and profile IDs
    // stay in the organizer-only liveSessions document.
    match /publicDisplays/{displayId} {
      allow get: if displayId == 'current'
        && (isOrganizer() || resource.data.enabled == true);
      allow list, delete: if false;
      allow create, update: if isOrganizer()
        && displayId == 'current'
        && request.resource.data.keys().hasOnly([
          'schemaVersion','enabled','date','teams','games',
          'currentGame','scoreTarget','updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.enabled is bool
        && request.resource.data.teams is list
        && request.resource.data.games is list;
    }

    // No access to any other documents, including future public views.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
